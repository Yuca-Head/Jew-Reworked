<UserControl     
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jew.Avalonia.ViewModels.Sales.Menus"
    xmlns:space="using:Jew.Avalonia.Views.Sales"
    x:Class="Jew.Avalonia.Views.Sales.SaleMenuView"
    x:DataType="vm:SalesMenuViewModel">

    <Grid ColumnDefinitions="*,400"  RowDefinitions="50,*" ShowGridLines="False" Background="White">
        
        <StackPanel Grid.Row="0" Classes="menu-header" Grid.Column="0" Grid.RowSpan="1" Orientation="Horizontal">
                <Border/>
            <TextBlock Text="Ventas"/>
        </StackPanel>    

        <Grid Grid.Row="1" RowDefinitions="130,*,250" Background="#f1f1f1" Margin="5" ShowGridLines="False">
            
            <space:SaleClientCard Grid.Row="0" DataContext="{Binding ClientCardVM}"/>

            <space:SaleCartCard  Grid.Row="1" DataContext="{Binding Cart}"/>

            <space:SaleDetailsCard Grid.Row="2" DataContext="{Binding Details}"/>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1" Background="#f1f1f1" Margin="5">
            <space:SaleSummaryCard DataContext="{Binding Summary}"/>
        </Grid>
    </Grid>
</UserControl>