<UserControl     
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jew.Avalonia.ViewModels.Sales.Menus"
    x:Class="Jew.Avalonia.Views.Sales.SaleSummaryCard"
    x:DataType="vm:SaleSummaryCardVM">

    <StackPanel>
        <StackPanel>
            <TextBlock Foreground="#8c52ff" Text="Resumen de la venta" HorizontalAlignment="Center" FontSize="30" />

            <StackPanel Orientation="Horizontal" Margin="0,50,0,0" HorizontalAlignment="Center">
                <TextBlock Foreground="#555252" Text="Total de la venta:" FontSize="25"/>
                <TextBlock Text="{Binding Total, StringFormat='{}{0:C}'}" Margin="10,0,0,0" Foreground="#64E964" FontSize="23"/>
            </StackPanel>  

            <StackPanel Orientation="Horizontal" Margin="0,50,0,0" HorizontalAlignment="Center">
                <TextBlock Foreground="#555252" Text="Cantidad de Productos:" FontSize="20"/>
                <TextBlock Text="{Binding ItemsCount}" Margin="10,0,0,0" Foreground="#B664E9" FontSize="18"/>
            </StackPanel>
        </StackPanel>



        <StackPanel Margin="0, 200, 0, 0">
            <TextBlock Text="{Binding ErrorMessage}" Name="ErrorMessage" IsVisible="{Binding HasError}"
             MaxWidth= "320" Classes="error" FontSize="15" TextWrapping="Wrap" MaxHeight="100"/>
            <Button Command="{Binding RegisterSafeSaleCommand}" Content="Realizar venta" HorizontalContentAlignment="Center" 
            Width="300" Height="60" FontSize="30" Classes="common" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
            <Button Command="{Binding RegisterUnsafeSaleCommand}" Content="Vender de todos modos" 
            HorizontalContentAlignment="Center" IsVisible= "{Binding ShowUnsafeSaleOption}"
            Width="300" Height="60" FontSize="20" Classes="warning common" HorizontalAlignment="Center"
            VerticalContentAlignment="Center" Margin= "0,30,0,0" Background="red"/>
            <Button Command="{Binding ClearFormCommand}" Content="Cancelar" Margin="0,30,0,0" Width="300" Classes="warning"  Height="60" FontSize="30" Foreground="#8c52ff"
              HorizontalAlignment="Center" Background="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </StackPanel>   
    </StackPanel>   

</UserControl>