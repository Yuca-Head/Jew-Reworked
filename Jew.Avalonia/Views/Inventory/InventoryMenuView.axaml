<UserControl     
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jew.Avalonia.ViewModels.Inventory.Menus"
    x:Class="Jew.Avalonia.Views.Inventory.InventoryMenuView"
    x:DataType="vm:InventoryMenuViewModel">

    <Grid Background="White" RowDefinitions="50, 200, *" ShowGridLines="False">

        <!--Shared Header-->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="1" Classes="menu-header" Orientation="Horizontal">
            <Border/>
            <TextBlock Text="Inventario"/>
        </StackPanel>    
        
        <!--Additional Info.-->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="50" Classes="additionalInfo-container">

            <Border>
                    <StackPanel Orientation="Horizontal">
                    <Image Source="avares://Jew.Avalonia/Assets/3dBoxIcon.png" Width="70" Height="70"/>
                    <StackPanel VerticalAlignment="Center" Margin="10">
                        <TextBlock Text="Total de Productos" Foreground="#a5a5a5" TextWrapping="Wrap" FontSize="15"/>
                        <TextBlock Text="{Binding Products.Count}" FontSize="20" Foreground="Black"/>
                        <TextBlock Text="Produtos Ingresados" Foreground="#a5a5a5" TextWrapping="Wrap" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel Orientation="Horizontal">
                    <Image Source="avares://Jew.Avalonia/Assets/WarningIcon.png" Width="60" Height="60"/>
                    <StackPanel VerticalAlignment="Center" Margin="10">
                        <TextBlock Text="Productos con bajo stock" Foreground="#a5a5a5" TextWrapping="Wrap" MaxWidth= "140" FontSize="15"/>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="20" Foreground="Black"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border>    
                <StackPanel Orientation="Horizontal">
                    <Image Source="avares://Jew.Avalonia/Assets/CrossMarkIcon.png" Width="70" Height="70"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Productos sin Stock" Foreground="#a5a5a5" TextWrapping="Wrap" MaxWidth= "140" FontSize="15"/>
                        <TextBlock Text="{Binding ProductsWithoutExistence}" FontSize="20" Foreground="Black"/>
                        <TextBlock Text="Agotados" Foreground="#a5a5a5" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#91AD88F8" Height="200" Width="515">

            <StackPanel>
                    <TextBlock Text="VALORES FILTRADOS" Foreground="Black" Width="205" FontSize="20" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Border>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="avares://Jew.Avalonia/Assets/MoneyIcon.png" Width="70" Height="70"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Valor de Inventario" Foreground="#a5a5a5" TextWrapping="Wrap" FontSize="15"/>
                                    <TextBlock Text="{Binding TotalInventory, StringFormat='{}{0:C}'}" FontSize="20" Foreground="Black"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="avares://Jew.Avalonia/Assets/InStockIcon.png" Width="60" Height="60"/>
                                <StackPanel VerticalAlignment="Center" Margin="10">
                                    <TextBlock Text="Stock de Inventario" Foreground="#a5a5a5" TextWrapping="Wrap" FontSize="15"/>
                                    <TextBlock Text="{Binding TotalStock}" FontSize="20" Foreground="Black"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>

        <!--/Additional info-->

            <!--Main List-->
        <Border Background="#f1f1f1" Grid.Row="2" Margin="10">

            <StackPanel  Margin="20" >

                <!--Filters-->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,30,0">
                        <TextBlock Text="Buscar Producto" Foreground="Black" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SearchCode}" Width="200" Classes="searchbar" Watermark="Buscar Por Código"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,30,0">
                        <TextBlock Text="Categoría" Foreground="Black" FontSize="15" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding CatFilter.CategoriesFilter}" 
                        SelectedItem="{Binding CatFilter.SelectedCategory}"  Width="200" Classes="common"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Solo bajo Stock" Foreground="Black" FontSize="15" FontWeight="SemiBold"/>
                        <CheckBox IsChecked="{Binding LowStockOnly}" Classes="common" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!--/Filters-->

                
                <TextBlock Text="Listado de productos en inventario" Foreground="Black" 
                    FontSize="22" Margin="10" FontWeight="SemiBold"/>
                <!--
                <Border Classes="output-generated" CornerRadius="0">

                    <Grid ColumnDefinitions="*,*,*,*,*,*">
                        <Grid.Styles>
                            <Style Selector="Grid TextBlock">
                                <Setter Property="FontSize" Value="15"/>
                            </Style>    
                        </Grid.Styles>
                        <TextBlock Text="Código" Classes="menu-list-header stretch" Grid.Column="0" Foreground="Black"/>
                        <TextBlock Text="Producto" Classes="menu-list-header stretch" Grid.Column="1" Foreground="Black"/>
                        <TextBlock Text="Categoria" Classes="menu-list-header stretch" Grid.Column="2" Foreground="Black"/>
                        <TextBlock Text="Stock" Classes="menu-list-header stretch" Grid.Column="3" Foreground="Black"/>
                        <TextBlock Text="Costo Unitario" Classes="menu-list-header stretch" Grid.Column="4" Foreground="Black"/>
                        <TextBlock Text="Valor Total" Classes=  "menu-list-header stretch" Grid.Column="5" Foreground="Black"/>
                    </Grid> 
                </Border>
                -->
                
                        <!--
                        <ItemsControl ItemsSource="{Binding DisplayedProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Classes="productList" ColumnDefinitions="*,*,*,*,*,*" Margin="5">
                                        <TextBlock Text="{Binding Code}"/>
                                        <TextBlock Text="{Binding Name}" Grid.Column="1"/>
                                        <TextBlock Text="{Binding Category.Name}" Grid.Column="2"/>
                                        <TextBlock Text="{Binding Stock}" Grid.Column="3"/>
                                        <TextBlock Text="{Binding AverageCost, StringFormat='{}{0:C}'}" Grid.Column="4"/>
                                        <TextBlock Text="{Binding Total, StringFormat='{}{0:C}'}" Grid.Column="5"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>-->
                        
                <DataGrid ItemsSource="{Binding DisplayedProducts}"
                AutoGenerateColumns="False" IsReadOnly="True" Classes="common" 
                Background="#d5d5d5" VerticalAlignment="Stretch" Height= "350" Margin= "0,10,0,0">
                
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"
                        Binding="{Binding Code}" />
                        <DataGridTextColumn Header="Producto"
                        Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Categoría"
                        Binding="{Binding Category.Name}" />
                        <DataGridTextColumn Header="Stock"
                        Binding="{Binding Stock}" />
                        <DataGridTextColumn Header="Costo Unitario"
                        Binding="{Binding AverageCost, StringFormat='{}{0:C}'}" />
                        <DataGridTextColumn Header="Valor Total"
                        Binding="{Binding Total, StringFormat='{}{0:C}'}"/>
                        <DataGridTextColumn Header="Ingreso"
                        Binding="{Binding CreatedDate}"/>
                    </DataGrid.Columns>
                </DataGrid>
            

            </StackPanel>

        </Border>


    </Grid>

</UserControl>