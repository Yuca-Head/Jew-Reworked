<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jew.Avalonia.ViewModels.Products.Menus"
    x:Class="Jew.Avalonia.Views.Products.CategoryCreatorCard"
    x:DataType="vm:CreateCategoryCardVM">
    
    <Border Background="#31C1ABED" Grid.Row="1" CornerRadius="8" Margin="10" Padding="10"> 
        <Grid ShowGridLines="False" RowDefinitions="Auto,*,40,*">
            <TextBlock Text="Crear Categoría" FontSize="20" Classes="header"/>

            <StackPanel Grid.Row= "1">
                <TextBlock Text="Nombre"/>
                <TextBox Classes="searchbar" Text="{Binding Category.Name}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Classes="error" FontSize="15" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" VerticalAlignment="Top"/>
            <Grid ColumnDefinitions= "*,*" Grid.Row="3">    

                <Button  Classes="common" Content="Registrar Categoría" Height="40" Width="200" Command="{Binding CreateCategoryCommand}"
                HorizontalAlignment="Center" FontSize="20" VerticalContentAlignment="Center" VerticalAlignment="Center"/>

                <Button  Grid.Column="1" Classes="common warning" Content="Cancelar" Height="40"
                VerticalAlignment="Center"  Width="200"  Command="{Binding ClearCommand}"
                HorizontalAlignment="Center" FontSize="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>