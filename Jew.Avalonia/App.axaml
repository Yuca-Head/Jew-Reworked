<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Jew.Avalonia.App"
             xmlns:local="using:Jew.Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Jew.Avalonia/Styles/Buttons.axaml"/>
        <StyleInclude Source="avares://Jew.Avalonia/Styles/Cards.axaml"/>
        <StyleInclude Source="avares://Jew.Avalonia/Styles/Text.axaml"/>
        <StyleInclude Source="avares://Jew.Avalonia/Styles/Collections.axaml"/>
    </Application.Styles>

</Application>